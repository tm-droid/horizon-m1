{
	"credit": "Created by FreshLX for Fresh Animations",
	"animations": [
		{
			"varb.pfc": "frame_counter == var.pre_frame_counter",
			"var.hy": "clamp(head_yaw,-90,90)",
			"var.testing": "0",
			"var.headx": "if( varb.pfc, var.headx, head.rx )",
			"var.lying": "clamp( if( varb.pfc, var.lying, rule_index==1, var.lying +6 *frame_time, var.lying -6 *frame_time ), 0, 1 )",
			"var.count_sleep": "clamp( if( varb.pfc, var.count_sleep, rule_index==1 && limb_speed<=0.1 && !is_hurt, var.count_sleep +0.1 *frame_time, var.count_sleep -2 *frame_time ), 0, 1 )",
			"var.sleep": "clamp(var.count_sleep*10 -9, 0, 1)",
			"var.count_swim": "clamp( if(varb.pfc, var.count_swim, !is_riding&&!is_on_ground&&is_in_water, var.count_swim +0.8 *frame_time, var.count_swim -0.8 *frame_time ), 0, 1-var.lying )",
			"var.scared": "  clamp( if(varb.pfc, var.scared  , limb_speed>0.9  , var.scared   +2   *frame_time, var.scared   -2   *frame_time ), 0, 1-var.lying )",
			"var.r": "pi*random(id)*4",
			"var.b": "age /(11 -random(id)*2)*if(is_child, 1.5, 1)",
			"var.ls": "limb_swing/if(is_child, if( varb.baby_model, 1.7, 2 ), 1)/if( limb_speed>0.75, 1.4 +(0.2*random(id)), 1.1 +(0.2*random(id)) )",
			"varb.variantA": "varb.is_wanderer && between(random(id), 0.1, 0.6) || between(random(id), 0.4, 0.5)",
			"varb.variantB": "between(random(id), 0, 0.2)",
			"var.swim": "limb_swing/if(is_child, 2, 1)/2 +age/if(is_child, 2, 3)",
			"var.walk": "if( is_child, clamp( 2.5-limb_speed*4, 0, 1), clamp(9-limb_speed*10, 0, 1) )*(1-var.lying)*clamp(limb_speed*6, 0, 1)",
			"var.run": " if( is_child, clamp(-1.5+limb_speed*4, 0, 1), clamp(-4+limb_speed*5, 0, 1) )*(1-var.lying)",
			"var.dance": "if(is_child, clamp(-2 +sin((pi*random(id)*2) +age/420)*10, 0, 1)*clamp(limb_speed*6, 0, 1), varb.variantA, clamp(-7 +sin(var.r +age/280)*10, 0, 1)*var.walk, 0)*(1-var.scared)",
			"var.ylook": "clamp(sin(var.r+age/60)*6, 0, 1)*1.2",
			"var.nope0": "clamp( if( varb.pfc, var.nope0, var.headx==0.4, var.nope0 +4 *frame_time, var.nope0 -2 *frame_time ), 0, 1-var.lying )",
			"var.nope": "(0.5-0.5*cos( clamp(-239 +cos(var.r+age/411)*240,  var.nope0, 1  )*pi ))/(2-var.nope0)*clamp(1-limb_speed*4, var.nope0, 1)*(1-var.lying)",
			"var.yep": " (0.5-0.5*cos( clamp(-239 +sin(var.r+age/274)*240, 0, 1-var.nope0 )*pi ))/2  *clamp(1-limb_speed*4,   0, 1)*(1-var.lying)",
			"var.nov1": "if(!is_child&&random(id)<0.4, (0.5-0.5*cos( clamp(-5.6 +cos(-pi/6 +var.r +age  /80 )*6 , 0, 1)*pi ))*clamp(2-limb_speed*4, 0, 1), 0)*(1-var.lying)",
			"var.nov2": "if(   random(id)<0.7, (0.5-0.5*cos( clamp(-78  +cos(-pi/4 +var.r +var.b/20 )*80, 0, 1)*pi ))*clamp(1-limb_speed*2, 0, 1), 0)*(1-var.lying)",
			"var.nov3": "(0.5-0.5*cos( clamp( if( varb.is_wanderer, sin(var.r +age/67)*10 -7.5, sin(var.r +age/153)*20 -19 ), 0, 1)*pi ))*clamp(2-limb_speed*4, 0, 1)*(1-var.lying)",
			"var.yrot_offset": "if( varb.pfc, var.yrot_offset, var.yrot_offset +if( between( var.pre_roty-rot_y, -pi*2, -pi*2+0.2 ), -pi*2, between( var.pre_roty-rot_y, pi*2-0.2, pi*2 ), pi*2, 0 ) )",
			"var.roty": "rot_y +var.yrot_offset",
			"var.headroty": "var.pre_headroty+if(is_riding,0,var.roty)",
			"var.head_rot": "if( varb.pfc, var.head_rot, !equals(var.headroty,var.pre_Oheadroty,1), var.headroty, var.headroty*min(1,frame_time*16) +var.head_rot*max(0,1-frame_time*16) )",
			"var.Created_by_FreshLX_for_Fresh_Animations": "1"
		},
		{
			"head.rx": "torad(head_pitch)/1.5 +if(!is_riding&&!is_on_ground&&is_in_water, cos(var.swim*2)/30 +torad(-10) +torad(10*clamp(limb_speed*8, 0, 1)), if(var.scared>0||varb.variantB, -torad(10)*if(var.scared>0, var.scared, clamp(sin(limb_speed*3), 0, 1)), 0) +sin(var.ls*2)/20*limb_speed )  +if(varb.variantA, -torad(5)*clamp(-1+limb_speed*2, 0, 1), 0) +(sin(limb_swing/2)/4 +torad(20))*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0) +( cos(-pi/3 +var.r+var.b +sin(var.r+var.b))/4 -torad(10) )*var.nov2 +if(is_child, 0, torad(20))*var.nope +sin(var.r+age/1.2)/6*clamp(1-sin(var.r+age/6 +cos(var.r+age/12)), 0, 1)*var.yep +cos(pi/4 +var.ls*2 +cos(var.ls*2)/3)/6*var.dance +torad(-20)*var.nov3 +( 0.15 -sin(var.r +var.b -cos(var.r +var.b)*var.sleep)/40 )*var.lying",
