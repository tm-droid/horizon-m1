			"nose.ty": "0",
			"body.rx": "   if(!is_riding&&!is_on_ground&&is_in_water,  torad(20)*clamp(limb_speed*8, 0, 1), sin(var.r +var.b)/60*( 1-0.5*var.lying ) +cos(var.ls*2)/18*limb_speed*if(varb.variantA, var.run, 0) +if(varb.variantA, torad(10)*limb_speed, torad(-5)*clamp(1-limb_speed*2, 0, 1)*clamp(-1+random(id)*2, 0, 1)*(1-var.lying) ) +clamp(torad(head_pitch)/4, 0, pi/20)/3 ) +( cos(var.r+var.b +sin(var.r+var.b))/12 )*var.nov2 -(sin(limb_swing/2)/2 +torad(20))/3*if(is_hurt, -sin(hurt_time*pi/5)/6*hurt_time, 0) -sin(var.r+age/1.2)/40*clamp(1-sin(var.r+age/6 +cos(var.r+age/12)), 0, 1)*var.yep",
