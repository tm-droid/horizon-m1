     "var.scale": "180 * frame_time",
     "var.x_diff": "(pos_x - var.prev_x)  * 1 / max(var.scale, 0.001)",
     "var.prev_x": "pos_x",
     "var.force_x": "0.0167 * (var.x_diff - var.x_x) * var.scale",
     "var.velocity_x": "(var.force_x + var.velocity_x) * pow(0.98 , var.scale)",
     "var.x_x": "clamp(var.x_x + var.velocity_x/8 * var.scale,-0.05,0.05)",
     "var.x_z": "clamp(var.x_z + var.velocity_z/8 * var.scale,-0.05,0.05)",
     "var.smf": "var.smf +(move_forward-var.smf)/4*frame_time*5"
    },
    {
     "tail.rx": "clamp(limb_speed*var.smf,0,1)+0.15"
