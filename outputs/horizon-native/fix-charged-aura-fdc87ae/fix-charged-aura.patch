+    fn a_swirl_face_lands_inside_its_sprite() {
+        // A face scrolled past the sprite's edge, the sprite at (0.5, 0.25) and 0.25 x 0.125.
+        let mut face = quad(
+            super::super::ENERGY_SWIRL_OVERLAY,
+            crate::breaking::stage_light([0.5, 0.25]),
+            [
+                ([0.0; 3], [1.2, 0.4]),
+                ([0.0; 3], [1.5, 0.4]),
+                ([0.0; 3], [1.5, 0.6]),
+                ([0.0; 3], [1.2, 0.6]),
+            ],
+        );
+        for v in &mut face {
+            v.color = crate::breaking::stage_light([0.25, 0.125]);
+        }
+        as_swirl_texture(&mut face, [1024, 1024]);
+        for v in &face {
+            assert!((0.5..=0.75).contains(&v.uv[0]) && (0.25..=0.375).contains(&v.uv[1]));
+            assert_eq!((v.layer, v.light, v.color), (0, 0x0000_f0f0, 0x80ff_ffff));
+        }
+        assert!((face[0].uv[0] - (0.5 + 0.2 * 0.25)).abs() < 1e-3);
