+/// Energy swirl quads (`ENERGY_SWIRL_OVERLAY`) as ordinary entity quads for a pack's program:
+/// their sprite-local, scrolling UVs onto the armour sprite whose origin the light bytes and
+/// size the colour bytes carry (fs_energy_swirl), each face's window kept inside the sprite.
+/// Full bright, white at half alpha: blended, it brightens what it covers, as the additive
+/// swirl does.
+fn as_swirl_texture(vertices: &mut [Vertex], atlas: [u32; 2]) {
+    let dims = [atlas[0].max(1) as f32, atlas[1].max(1) as f32];
+    let unpack = |x: u32| [(x & 65535) as f32 / 65535.0, (x >> 16) as f32 / 65535.0];
+    for quad in vertices.as_chunks_mut::<4>().0 {
+        let light = unpack(quad[0].light);
+        let origin = [0, 1].map(|i| (light[i] * dims[i]).round() / dims[i]);
+        let size = unpack(quad[0].color);
+        let min = [0, 1]
+            .map(|i| (quad.iter().map(|v| v.uv[i]).fold(f32::INFINITY, f32::min) + 0.0001).floor());
+        for v in quad {
+            v.uv = [0, 1].map(|i| origin[i] + (v.uv[i] - min[i]).clamp(0.001, 0.999) * size[i]);
+            v.layer = 0;
+            v.light = 0x0000_f0f0;
+            v.color = 0x80ff_ffff;
+        }
+    }
+}
