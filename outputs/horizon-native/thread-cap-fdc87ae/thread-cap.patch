+/// The cores a pool of bulk helpers should fit on without taking the render and server
+/// threads' core: `worker_count`, and on Apple silicon no more than the performance cores
+/// (an M1's 4 of 8). A pool sized from `worker_count` there put 7 threads on 4 fast cores
+/// during chunk loading; the pools that must not wait behind the frame size from this.
+pub fn fast_cores() -> usize {
+    static FAST: OnceLock<usize> = OnceLock::new();
+    *FAST.get_or_init(|| {
+        let all = worker_count();
+        performance_cores().map_or(all, |fast| all.min(fast))
+    })
+}
+
+/// Set while the game accepts connections from the network (a LAN world, a dedicated
+/// server): the pools sized for one local player then use all their threads.
+static NETWORK_OPEN: AtomicBool = AtomicBool::new(false);
+
+/// Record that the game starts or stops accepting network connections.
+pub fn set_network_open(open: bool) {
+    NETWORK_OPEN.store(open, Ordering::Relaxed);
+}
+
+/// Whether the game accepts connections from the network (`set_network_open`).
+pub fn network_open() -> bool {
+    NETWORK_OPEN.load(Ordering::Relaxed)
+}
+
+/// Called by a network thread (and again whenever `network_open` changed): with only the
+/// window's own in-memory connection to serve (`wide` false) it runs at utility quality of
+/// service on macOS, as it mostly waits and frames small packets, so a burst of chunk
+/// packets doesn't take a performance core from the render thread; with guests (`wide`) it
+/// returns to the default class. Nothing elsewhere. Whether the OS took it.
+pub fn network_current(wide: bool) -> bool {
+    network(wide)
+}
+
+#[cfg(target_vendor = "apple")]
+fn network(wide: bool) -> bool {
+    let class = if wide {
+        libc::qos_class_t::QOS_CLASS_DEFAULT
+    } else {
+        libc::qos_class_t::QOS_CLASS_UTILITY
+    };
+    // SAFETY: sets the calling thread's own QoS class; no pointers.
+    unsafe { libc::pthread_set_qos_class_self_np(class, 0) == 0 }
+}
+
+#[cfg(not(target_vendor = "apple"))]
+fn network(_wide: bool) -> bool {
+    false
+}
+
 /// [`default_workers`] for `cores` cores, of which `performance` (asked only here, the
 /// sysctl) are performance cores where the machine tells them apart (`None` elsewhere):
 /// one less than the smaller count, at least 1.
