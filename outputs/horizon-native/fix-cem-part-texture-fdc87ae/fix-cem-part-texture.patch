+/// The secondary draws in `render::layers` use their own textures. Several of
+/// those layers have a standalone model whose key ends in `#main`.
+fn secondary_layer(key: &str) -> bool {
+    layer_suffix(key) != "main"
+        || matches!(
+            key,
+            "wolf_armor#main"
+                | "horse_armor#main"
+                | "undead_horse_armor#main"
+                | "nautilus_armor#main"
+                | "happy_ghast_harness#main"
+                | "happy_ghast_ropes#main"
+                | "happy_ghast_baby_ropes#main"
+        )
+}
