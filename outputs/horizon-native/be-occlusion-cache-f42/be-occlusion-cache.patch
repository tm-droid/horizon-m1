+#[cfg(test)]
+mod static_occlusion_bounds_tests {
+    use super::*;
+
+    fn vertex(pos: [f32; 3]) -> Vertex {
+        Vertex {
+            pos,
+            ..bytemuck::Zeroable::zeroed()
+        }
+    }
+
+    #[test]
+    fn includes_overhangs_and_negative_section_origins() {
+        let vertices = [vertex([-2.0, 0.0, 15.0]), vertex([18.0, 19.0, 17.0])];
+        let (min, max) = static_occlusion_bounds([-32, -64, -16], &vertices).unwrap();
+        assert_eq!(min, [-34.05, -64.05, -1.05]);
+        assert_eq!(max, [-13.95, -44.95, 1.05]);
+    }
+
+    #[test]
+    fn invalid_or_empty_geometry_has_no_occlusion_proof() {
+        assert!(static_occlusion_bounds([0; 3], &[]).is_none());
+        for invalid in [f32::NAN, f32::INFINITY, f32::NEG_INFINITY] {
+            assert!(static_occlusion_bounds([0; 3], &[vertex([invalid, 0.0, 0.0])]).is_none());
+        }
+    }
+}
