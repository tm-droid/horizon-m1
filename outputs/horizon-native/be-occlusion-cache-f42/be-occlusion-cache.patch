+        static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+        if !*ENABLED.get_or_init(|| {
+            std::env::var("HORIZON_BE_OCCLUSION_CACHE").as_deref() == Ok("1")
+        }) || self.pack_ids.is_some()
