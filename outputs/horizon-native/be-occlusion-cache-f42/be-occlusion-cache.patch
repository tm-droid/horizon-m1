+        {
+            return false;
+        }
+        // This culler already enforces vanilla models, a valid player/camera,
+        // and same-frame opaque uploaded occluders. Async results are not reused.
+        let Some(culler) = &self.entity_culler else {
+            return false;
+        };
+        visible.retain(|section| {
+            let Ok(index) = snapshots.binary_search_by_key(section, |s| s.section) else {
+                return true;
+            };
+            let Some((min, max)) = snapshots[index].occlusion_bounds else {
+                return true;
+            };
+            // Keep the GPU's camera-relative f32 arithmetic well within the
+            // 0.05 edge margin, including arbitrarily oversized cached models.
+            if (0..3).any(|axis| {
+                (min[axis] - culler.camera[axis]).abs() > 512.0
+                    || (max[axis] - culler.camera[axis]).abs() > 512.0
+            }) {
+                return true;
+            }
+            !culler.occluded(min, max, |pos| self.occluder_ready(pos))
+        });
+        true
+    }
