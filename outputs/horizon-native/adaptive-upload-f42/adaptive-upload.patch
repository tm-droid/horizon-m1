+/// Adaptive mesh-upload pacing (u15 adaptive-upload-f42). Scales the per-frame upload allowance
+/// (Chunk Updates, Upload Budget, or the unbudgeted 2/6 ms slice) by a factor in `1.0..=2.0`.
+/// The factor is never below 1, so a frame uploads at least what it does today; it only grows when
+/// the frame is cheap, the player stands still, or the backlog is growing, and never while the busy
+/// time is at or above `TIGHT_MS` or before any frame has been timed (so it cannot add work to a slow
+/// frame). `reset` forgets the timing on a world join, respawn or dimension change.
+/// `HORIZON_ADAPTIVE_UPLOAD=0` restores the fixed allowance.
+mod adaptive_upload {
+    use std::cell::RefCell;
+    use std::sync::OnceLock;
+    use std::time::Duration;
+
+    /// Ceiling of the factor.
+    pub const MAX_SCALE: f32 = 2.0;
+    /// Floor of the factor while the backlog has recently grown.
+    pub const GROWING_SCALE: f32 = 1.5;
+    /// Busy time (max of CPU and GPU frame ms) at or below which the factor is `MAX_SCALE`.
+    pub const RELAXED_MS: f32 = 8.0;
+    /// Busy time at or above which the factor is 1 (the fixed allowance).
+    pub const TIGHT_MS: f32 = 14.0;
+    /// Updates with an unchanged centre chunk before the player counts as standing still.
+    pub const STILL_FRAMES: u32 = 20;
+    /// Updates a growth of the backlog keeps `GROWING_SCALE` in force.
+    pub const GROWING_HOLD: u32 = 10;
+    const EMA_ALPHA: f32 = 0.2;
+
+    #[derive(Default)]
+    pub struct Tracker {
+        busy_ms: f32,
+        seeded: bool,
+        centre: Option<(i32, i32)>,
+        still: u32,
+        backlog: usize,
+        growing: u32,
+    }
+
+    impl Tracker {
+        /// A rendered frame's busy time in ms.
+        pub fn note_frame(&mut self, ms: f32) {
+            if !ms.is_finite() || ms <= 0.0 {
+                return;
+            }
+            self.busy_ms = if self.seeded {
+                self.busy_ms + (ms - self.busy_ms) * EMA_ALPHA
+            } else {
+                ms
+            };
+            self.seeded = true;
+        }
+
+        /// The factor for this update: `centre` is the streaming centre chunk, `backlog` the number
+        /// of meshes still waiting after this update's new ones joined the queue.
+        pub fn scale(&mut self, centre: (i32, i32), backlog: usize) -> f32 {
+            if self.centre == Some(centre) {
+                self.still = self.still.saturating_add(1);
+            } else {
+                self.still = 0;
+                self.centre = Some(centre);
+            }
+            if backlog > self.backlog {
+                self.growing = GROWING_HOLD;
+            } else {
+                self.growing = self.growing.saturating_sub(1);
+            }
+            self.backlog = backlog;
+            if backlog == 0 {
+                return 1.0;
+            }
+            // A busy frame (or no timing yet) never gets more than the fixed allowance, whatever
+            // the backlog or the player does: the factor must not add work to a slow frame.
+            if !self.seeded || self.busy_ms >= TIGHT_MS {
+                return 1.0;
+            }
+            let t = ((TIGHT_MS - self.busy_ms) / (TIGHT_MS - RELAXED_MS)).clamp(0.0, 1.0);
+            let headroom = 1.0 + (MAX_SCALE - 1.0) * t;
+            let mut scale = headroom;
+            if self.growing > 0 {
+                scale = scale.max(GROWING_SCALE);
+            }
+            if self.still >= STILL_FRAMES {
+                scale = MAX_SCALE;
+            }
+            scale.clamp(1.0, MAX_SCALE)
+        }
+    }
+
+    fn enabled() -> bool {
+        static ON: OnceLock<bool> = OnceLock::new();
+        *ON.get_or_init(|| std::env::var_os("HORIZON_ADAPTIVE_UPLOAD").is_none_or(|v| v != "0"))
+    }
+
+    thread_local! {
+        static TRACKER: RefCell<Tracker> = RefCell::new(Tracker::default());
+    }
+
+    /// Forget the busy-time history and queue state: a new world, respawn or dimension is a
+    /// different load, and the old frame times say nothing about it.
+    pub fn reset() {
+        TRACKER.with(|t| *t.borrow_mut() = Tracker::default());
+    }
+
+    pub fn note_frame(ms: f32) {
+        if enabled() {
+            TRACKER.with(|t| t.borrow_mut().note_frame(ms));
+        }
+    }
+
+    pub fn scale(centre: (i32, i32), backlog: usize) -> f32 {
+        if enabled() {
+            TRACKER.with(|t| t.borrow_mut().scale(centre, backlog))
+        } else {
+            1.0
+        }
+    }
+
+    /// `base` scaled up; 0 (no limit) stays 0, and the result is never below `base`.
+    pub fn scale_count(base: usize, scale: f32) -> usize {
+        if base == 0 {
+            0
+        } else {
+            ((base as f32 * scale).ceil() as usize).max(base)
+        }
+    }
+
+    pub fn scale_bytes(base: u64, scale: f32) -> u64 {
+        if base == 0 {
+            0
+        } else {
+            ((base as f64 * f64::from(scale)).ceil() as u64).max(base)
+        }
+    }
+
+    pub fn scale_duration(base: Duration, scale: f32) -> Duration {
+        base.mul_f32(scale.clamp(1.0, MAX_SCALE))
+    }
+
+    #[cfg(test)]
+    mod tests {
+        use super::*;
+
+        fn tracker(busy: f32) -> Tracker {
+            let mut t = Tracker::default();
+            t.note_frame(busy);
+            t
+        }
+
+        #[test]
+        fn never_below_one_and_never_above_two() {
+            for busy in [0.1_f32, 4.0, 8.0, 11.0, 14.0, 30.0, 500.0] {
+                for backlog in [0_usize, 1, 5, 400] {
+                    let mut t = tracker(busy);
+                    for n in 0..60 {
+                        let s = t.scale((n / 7, 0), backlog + n as usize % 3);
+                        assert!((1.0..=MAX_SCALE).contains(&s), "{busy} {backlog} {s}");
+                    }
+                }
+            }
+        }
+
+        #[test]
+        fn empty_backlog_and_no_data_use_the_fixed_allowance() {
+            assert_eq!(tracker(1.0).scale((0, 0), 0), 1.0);
+            let mut no_data = Tracker::default();
+            no_data.backlog = 50;
+            assert_eq!(no_data.scale((0, 0), 50), 1.0);
+            // No timed frame yet: a growing backlog or a standing player still gets 1.
+            let mut fresh = Tracker::default();
+            for n in 0..=2 * STILL_FRAMES {
+                assert_eq!(fresh.scale((0, 0), 5 + n as usize), 1.0, "update {n}");
+            }
+        }
+
+        #[test]
+        fn busy_frames_never_exceed_the_fixed_allowance() {
+            for busy in [TIGHT_MS, 14.5, 20.0, 40.0, 500.0] {
+                // Standing still with a growing backlog, then moving with one.
+                let mut still = tracker(busy);
+                let mut moving = tracker(busy);
+                for n in 0..=3 * STILL_FRAMES {
+                    assert_eq!(still.scale((3, 4), 12 + n as usize), 1.0, "{busy} still {n}");
+                    assert_eq!(moving.scale((n as i32, 0), 12 + n as usize), 1.0, "{busy} moving {n}");
+                }
+            }
+        }
+
+        #[test]
+        fn reset_forgets_the_busy_time_and_the_standing_count() {
+            note_frame(5.0);
+            for _ in 0..=STILL_FRAMES {
+                scale((0, 0), 10);
+            }
+            reset();
+            // Fresh state: no timing, so the fixed allowance, even with a growing backlog.
+            assert_eq!(scale((0, 0), 10), 1.0);
+            assert_eq!(scale((0, 0), 20), 1.0);
+        }
+
+        #[test]
+        fn busy_frames_defer_and_cheap_frames_grow() {
+            let steady = |busy: f32| {
+                let mut t = tracker(busy);
+                t.backlog = 10;
+                t
+            };
+            assert_eq!(steady(20.0).scale((0, 0), 10), 1.0);
+            assert_eq!(steady(5.0).scale((0, 0), 10), MAX_SCALE);
+            let s = steady(11.0).scale((0, 0), 10);
+            assert!(s > 1.0 && s < MAX_SCALE, "{s}");
+        }
+
+        #[test]
+        fn a_standing_player_gets_the_full_allowance_only_while_frames_are_not_busy() {
+            let mut t = tracker(10.0);
+            let mut last = 0.0;
+            for _ in 0..=STILL_FRAMES {
+                last = t.scale((3, 4), 12);
+            }
+            assert_eq!(last, MAX_SCALE);
+            // Moving again drops back to the frame's own headroom.
+            let moving = t.scale((3, 5), 12);
+            assert!(moving > 1.0 && moving < MAX_SCALE, "{moving}");
+            // A busy frame ends the full allowance at once, even though the player still stands.
+            for _ in 0..=STILL_FRAMES {
+                t.scale((3, 5), 12);
+            }
+            t.note_frame(100.0);
+            assert_eq!(t.scale((3, 5), 12), 1.0);
+        }
+
+        #[test]
+        fn a_growing_backlog_floors_the_factor_then_releases() {
+            let mut t = tracker(12.0);
+            assert_eq!(t.scale((0, 0), 1), GROWING_SCALE);
+            for _ in 0..GROWING_HOLD {
+                t.scale((0, 1), 1);
+            }
+            let released = t.scale((0, 2), 1);
+            assert!(released > 1.0 && released < GROWING_SCALE, "{released}");
+            assert_eq!(t.scale((0, 3), 9), GROWING_SCALE);
+        }
+
+        #[test]
+        fn scaled_allowances_keep_unlimited_and_never_shrink() {
+            assert_eq!(scale_count(0, 2.0), 0);
+            assert_eq!(scale_bytes(0, 2.0), 0);
+            assert_eq!(scale_count(12, 1.0), 12);
+            assert_eq!(scale_count(12, 1.5), 18);
+            assert_eq!(scale_count(12, 0.1), 12);
+            assert_eq!(scale_bytes(4096 * 1024, 2.0), 8192 * 1024);
+            assert_eq!(scale_bytes(1000, 0.5), 1000);
+            let base = Duration::from_millis(2);
+            assert_eq!(scale_duration(base, 1.0), base);
+            assert_eq!(scale_duration(base, 2.0), Duration::from_millis(4));
+            assert_eq!(scale_duration(base, 9.0), Duration::from_millis(4));
+            assert_eq!(scale_duration(base, 0.2), base);
+        }
+
+        /// Closed-loop settle model: after a flight the player stops with a backlog; a frame costs
+        /// `frame_ms` plus `ms_per_mesh` per upload. Draining with the adaptive factor never takes
+        /// longer than with the fixed allowance, whatever the frame cost.
+        #[test]
+        fn settle_never_takes_longer_than_the_fixed_allowance() {
+            for &(base_ms, per_mesh) in &[(3.0_f32, 0.2_f32), (8.0, 0.4), (12.0, 0.3), (20.0, 0.1), (6.0, 1.0)] {
+                for &backlog0 in &[20_usize, 200, 1500] {
+                    let run = |adaptive: bool| {
+                        let mut t = Tracker::default();
+                        let (mut backlog, mut wall) = (backlog0, 0.0_f32);
+                        let mut guard = 0;
+                        while backlog > 0 {
+                            let s = if adaptive { t.scale((0, 0), backlog) } else { 1.0 };
+                            let allowed = scale_count(12, s);
+                            let n = allowed.min(backlog);
+                            let frame = base_ms + per_mesh * n as f32;
+                            t.note_frame(frame);
+                            backlog -= n;
+                            wall += frame;
+                            guard += 1;
+                            assert!(guard < 100_000);
+                        }
+                        wall
+                    };
+                    let (fixed, adaptive) = (run(false), run(true));
+                    assert!(adaptive <= fixed + 1e-3, "{base_ms} {per_mesh} {backlog0}: {adaptive} > {fixed}");
+                }
+            }
+        }
+
+        /// While flying (centre changes every update) a steady queue only holds the growing floor
+        /// for `GROWING_HOLD` updates, then the factor falls back to the frame's own headroom (1
+        /// when the frames are busy).
+        #[test]
+        fn flight_with_a_steady_queue_returns_to_the_frames_headroom() {
+            let mut cheap = tracker(12.0);
+            let mut busy = tracker(16.0);
+            for n in 0..100 {
+                let s = cheap.scale((n, 0), 40);
+                if n < GROWING_HOLD as i32 {
+                    assert_eq!(s, GROWING_SCALE, "update {n}");
+                } else {
+                    assert!(s > 1.0 && s < GROWING_SCALE, "update {n}: {s}");
+                }
+                assert_eq!(busy.scale((n, 0), 40), 1.0, "busy update {n}");
+            }
+        }
+    }
+}
