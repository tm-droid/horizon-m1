+/// A gbuffers stage's render pass left open for the next stage to draw in, when every program
+/// drawn in it `merges`: one pass boundary fewer (a store and load of every attachment on a
+/// tile GPU). Dropping it ends the pass, which must happen before the encoder records anything.
+struct Carry {
+    rp: wgpu::RenderPass<'static>,
+    writes: Vec<(u32, usize)>,
+    /// Buffers the programs drawn in it sample.
+    reads: u16,
+    /// Buffers they write.
+    written: u16,
+}
+
+impl Carry {
+    /// Whether `pass` can draw in this render pass, as `run_lengths` joins programs: binding it
+    /// records nothing on the encoder, it writes exactly the same attachments, and neither side
+    /// samples a buffer the other writes.
+    fn takes(&self, pass: &Pass) -> bool {
+        pass.merges()
+            && pass.writes == self.writes
+            && pass.reads & self.written == 0
+            && pass.written & self.reads == 0
+    }
+
+    /// `rp`, still open after `pass` drew in it (with `reads` and `written` of the programs
+    /// before it), or `None` when `pass` doesn't merge: the pass then ends here.
+    fn after(
+        rp: wgpu::RenderPass<'static>,
+        pass: &Pass,
+        reads: u16,
+        written: u16,
+    ) -> Option<Self> {
+        pass.merges().then(|| Carry {
+            rp,
+            writes: pass.writes.clone(),
+            reads: reads | pass.reads,
+            written: written | pass.written,
+        })
+    }
+}
