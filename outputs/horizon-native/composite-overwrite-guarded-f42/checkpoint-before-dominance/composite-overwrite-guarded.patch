+/// Whether composite vertex stage `code` (preprocessed) draws our quad unmoved: its one
+/// mention of `gl_Position` sets it to the composite matrix times `gl_Vertex`, which maps the
+/// quad onto the whole target. A second mention (a moved, scaled or jittered quad), or any
+/// other form, is not proven to cover the target: false.
+fn covers_target(code: &str) -> bool {
+    // User clipping/culling can remove pixels even with an unmoved quad.
+    if code.contains("gl_ClipDistance") || code.contains("gl_CullDistance") {
+        return false;
+    }
+    let code: String = code.chars().filter(|c| !c.is_whitespace()).collect();
+    code.matches("gl_Position").count() == 1
+        && [
+            "gl_Position=ftransform();",
+            "gl_Position=gl_ModelViewProjectionMatrix*gl_Vertex;",
+            "gl_Position=gl_ProjectionMatrix*gl_ModelViewMatrix*gl_Vertex;",
+        ]
+        .iter()
+        .any(|form| code.contains(form))
 }
 
