+/// An animated sprite's frames at the array's layer size. Once a renderer has built its
+/// sprite animator ([`pack_animations`]) they are kept lz4-compressed (upscaled sprites are
+/// runs of equal texels, so they shrink a lot): the GPU holds every frame's mip chain, and the
+/// copy only serves a renderer made again, which waits for [`Self::get`] to uncompress them.
+/// Shared by every clone of the animation (the animator's included), so packing frees the one
+/// copy.
+struct AnimationFrames {
+    /// Each frame's length in bytes.
+    lens: Vec<usize>,
+    /// Set by the first claim: later calls cost one atomic read.
+    packing: std::sync::atomic::AtomicBool,
+    /// As built; dropped once `packed` holds them.
+    raw: std::sync::Mutex<Option<Arc<Vec<Vec<u8>>>>>,
+    /// Every frame one after the other, as one lz4 block.
+    packed: std::sync::OnceLock<Vec<u8>>,
+}
+impl AnimationFrames {
+    fn new(frames: Arc<Vec<Vec<u8>>>) -> Self {
+        Self {
+            lens: frames.iter().map(Vec::len).collect(),
+            packing: std::sync::atomic::AtomicBool::new(false),
+            raw: std::sync::Mutex::new(Some(frames)),
+            packed: std::sync::OnceLock::new(),
+        }
+    }
+    /// The frames as built, uncompressed again once packed.
+    fn get(&self) -> Arc<Vec<Vec<u8>>> {
+        let raw = self.raw.lock().unwrap_or_else(|e| e.into_inner()).clone();
+        raw.unwrap_or_else(|| {
+            let total: usize = self.lens.iter().sum();
+            let packed = self.packed.get().map(Vec::as_slice).unwrap_or_default();
+            let all = lz4_flex::decompress_size_prepended(packed)
+                .ok()
+                .filter(|all| all.len() == total)
+                .unwrap_or_else(|| vec![0; total]);
+            let mut at = 0;
+            Arc::new(
+                self.lens
+                    .iter()
+                    .map(|&len| {
+                        at += len;
+                        all[at - len..at].to_vec()
+                    })
+                    .collect(),
+            )
+        })
+    }
+    /// True for the first caller only.
+    fn claim(&self) -> bool {
+        !self.packing.swap(true, std::sync::atomic::Ordering::Relaxed)
+    }
+    fn pack(&self) {
+        let raw = self.raw.lock().unwrap_or_else(|e| e.into_inner()).clone();
+        if let Some(raw) = raw {
+            let all: Vec<u8> = raw.iter().flatten().copied().collect();
+            let mut packed = lz4_flex::compress_prepend_size(&all);
+            packed.shrink_to_fit();
+            let _ = self.packed.set(packed);
+            // `get` reads the compressed copy from here on.
+            *self.raw.lock().unwrap_or_else(|e| e.into_inner()) = None;
+        }
+    }
+}
+/// Keep these animations' frames compressed from now on, once a renderer has taken them:
+/// packed one after the other on a thread of their own, the raw copies dropped as each is done.
+/// Cheap to call again: only frames not claimed before are packed.
+pub fn pack_animations(animations: &[SpriteAnimation]) {
+    let jobs: Vec<Arc<AnimationFrames>> = animations
+        .iter()
+        .map(|animation| animation.frames.clone())
+        .filter(|frames| frames.claim())
+        .collect();
+    if jobs.is_empty() {
+        return;
+    }
+    let job = move || {
+        for frames in &jobs {
+            frames.pack();
+        }
+    };
+    let fallback = job.clone();
+    if std::thread::Builder::new()
+        .name("Animation packing".into())
+        .spawn(job)
+        .is_err()
+    {
+        fallback();
+    }
+}
