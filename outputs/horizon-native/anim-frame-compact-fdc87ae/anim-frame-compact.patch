+#[cfg(test)]
+mod animation_frames_tests {
+    use super::*;
+
+    /// Frames as `lay_out` makes them: a `native`-px sprite scaled up by whole pixels to `size`.
+    fn upscaled(native: u32, size: u32, frames: u32) -> Vec<Vec<u8>> {
+        (0..frames)
+            .map(|f| {
+                (0..size * size)
+                    .flat_map(|i| {
+                        let (x, y) = (i % size * native / size, i / size * native / size);
+                        [x as u8, y as u8, (f * 40 + x + y) as u8, 255]
+                    })
+                    .collect()
+            })
+            .collect()
+    }
+
+    fn wait_packed(animation: &SpriteAnimation) {
+        let started = std::time::Instant::now();
+        while animation.frames.raw.lock().unwrap().is_some() {
+            assert!(started.elapsed().as_secs() < 10, "packing never finished");
+            std::thread::yield_now();
+        }
+    }
+
+    #[test]
+    fn frames_come_back_the_same_once_packed() {
+        let frames = upscaled(16, 64, 5);
+        let animation = test_frames(3, frames.clone(), r#"{"frametime":1,"frames":[0,1]}"#);
+        let before: Vec<Vec<u8>> = (0..5).map(|f| animation.pixels(f)).collect();
+        let resized = animation.resized_pixels(2, 16, 16);
+        assert_eq!(before, frames);
+        pack_animations(std::slice::from_ref(&animation));
+        wait_packed(&animation);
+        assert_eq!(animation.frame_count(), 5);
+        assert_eq!(*animation.frames(), frames);
+        assert_eq!(animation.pixels(4), frames[4]);
+        assert_eq!(animation.resized_pixels(2, 16, 16), resized);
+    }
+
+    #[test]
+    fn upscaled_frames_shrink_a_lot() {
+        let animation = test_frames(0, upscaled(16, 64, 8), r#"{"frametime":1,"frames":[0,1]}"#);
+        let raw: usize = animation.frames.lens.iter().sum();
+        pack_animations(std::slice::from_ref(&animation));
+        wait_packed(&animation);
+        let packed = animation.frames.packed.get().unwrap().len();
+        assert!(packed * 3 < raw, "{packed} of {raw} bytes");
+    }
+
+    #[test]
+    fn clones_share_one_packed_copy_and_packing_is_claimed_once() {
+        let animation = test_frames(1, upscaled(16, 32, 3), r#"{"frametime":1,"frames":[0,1]}"#);
+        let copy = SpriteAnimation { layer: 9, ..animation.clone() };
+        pack_animations(std::slice::from_ref(&animation));
+        // Already claimed: nothing more to pack for the clone or a repeat.
+        assert!(!copy.frames.claim());
+        pack_animations(std::slice::from_ref(&copy));
+        wait_packed(&animation);
+        assert!(copy.frames.raw.lock().unwrap().is_none());
+        assert_eq!(*copy.frames(), *animation.frames());
+        assert_eq!(copy.layer, 9);
+    }
+
+    #[test]
+    fn unequal_and_empty_frame_lists_round_trip() {
+        let frames = vec![vec![1, 2, 3, 4], vec![], vec![9; 12]];
+        let store = AnimationFrames::new(Arc::new(frames.clone()));
+        store.pack();
+        assert!(store.raw.lock().unwrap().is_none());
+        assert_eq!(*store.get(), frames);
+        let none = AnimationFrames::new(Arc::new(Vec::new()));
+        none.pack();
+        assert!(none.get().is_empty());
+    }
+}
