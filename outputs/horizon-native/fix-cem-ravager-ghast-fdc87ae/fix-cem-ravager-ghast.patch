+/// The part an animation target `part` of model `model` names: the vanilla part it aliases,
+/// unless it is a submodel's id and no top-level entry carries the name.
+fn animation_target(
+    model: &str,
+    part: &str,
+    sub_ids: &std::collections::HashSet<&str>,
+    top_names: &std::collections::HashSet<&str>,
+) -> String {
+    let vanilla = vanilla_part(model, part);
+    if vanilla != part && sub_ids.contains(part) && !top_names.contains(part) {
+        part.to_owned()
+    } else {
+        vanilla
+    }
+}
+/// The ids of `bone` and of every bone below it.
+fn collect_ids<'a>(bone: &'a Bone, out: &mut std::collections::HashSet<&'a str>) {
+    out.extend(bone.id.as_deref());
+    for c in &bone.children {
+        collect_ids(c, out);
+    }
+}
