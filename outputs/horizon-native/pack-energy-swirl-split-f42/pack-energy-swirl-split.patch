 /// Whether a run holds only geometry a gbuffers program can draw from the shared atlas: no
 /// celestial body, cloud, beam, End portal, crack or energy swirl (overlay codes Horizon's entity
 /// shader draws in its own way; entity.wgsl).
+fn plain_quad(v: &Vertex) -> bool {
+    !matches!(
+        v.layer & 0xffff,
+        2 | 4 | 6 | 9 | 10 | 11 | 12 | ENERGY_SWIRL_OVERLAY
+    )
+}
+
 fn plain(run: &[Vertex]) -> bool {
-    run.iter()
-        .step_by(4)
-        .all(|v| !matches!(v.layer & 0xffff, 2 | 4 | 6 | 9 | 10 | 11 | 12 | 34))
+    run.iter().step_by(4).all(plain_quad)
+}
+
+fn energy_swirl(v: &Vertex) -> bool {
+    v.layer & 0xffff == ENERGY_SWIRL_OVERLAY
+}
+
+/// Keep native energy swirl quads separate from the shader-pack body. Both
+/// destinations keep quad order. Other special materials retain the existing
+/// whole-span fallback, including when mixed with an energy swirl.
+fn cpu_runs(
+    run: &[Vertex],
+    program: Option<usize>,
+) -> impl Iterator<Item = (&[Vertex], Option<usize>)> {
+    let whole = program.filter(|&p| {
+        plain(run) || (p == DESTROY && run.iter().all(|v| matches!(v.layer, 11 | 12)))
+    });
+    let split = whole.is_none()
+        && matches!(program, Some(ENTITY | TRANSLUCENT))
+        && run.len().is_multiple_of(4)
+        && run.iter().step_by(4).all(|v| plain_quad(v) || energy_swirl(v));
+    let mut left = run;
+    std::iter::from_fn(move || {
+        if left.is_empty() {
+            return None;
+        }
+        if !split {
+            return Some((std::mem::take(&mut left), whole));
+        }
+        let swirl = energy_swirl(&left[0]);
+        let end = left.iter().step_by(4)
+            .position(|v| energy_swirl(v) != swirl)
+            .map_or(left.len(), |quad| quad * 4);
+        let (run, remaining) = left.split_at(end);
+        left = remaining;
+        Some((run, if swirl { None } else { program }))
+    })
 }
 
