diff -ruN orig/crates/horizon-client-render/src/gfx/pack_warm.rs work/crates/horizon-client-render/src/gfx/pack_warm.rs
--- a/crates/horizon-client-render/src/gfx/pack_warm.rs	1970-01-01 07:30:00
+++ b/crates/horizon-client-render/src/gfx/pack_warm.rs	2026-11-10 14:27:37
@@ -0,0 +1,92 @@
+//! Warming a shader pack's other dimension folders. The first visit to a dimension whose folder
+//! the driver hasn't compiled yet takes seconds (Metal compiles each program cold; a folder it
+//! has seen takes a fraction of that), so once the current dimension's pack runs, the game
+//! builds the other folders' pipelines in the background, one at a time, and drops them: only
+//! the driver's shader cache keeps the work.
+
+use std::time::{Duration, Instant};
+
+/// How long a pack runs (or a warm-up built) before the next warm-up starts.
+const SETTLE: Duration = Duration::from_secs(5);
+/// The threads a warm-up compiles on: few, so the game keeps its cores.
+pub(super) const THREADS: usize = 2;
+
+/// Which folders have been built or are being warmed since the pack was picked.
+#[derive(Default)]
+pub struct Warm {
+    folders: Vec<String>,
+    /// Nothing left to warm.
+    done: bool,
+    settled: Option<Instant>,
+}
+
+impl Warm {
+    /// The pack was installed (or a warm-up ended): wait before the next warm-up.
+    pub(super) fn settle(&mut self) {
+        self.settled = Some(Instant::now());
+    }
+
+    /// Whether to look for a folder to warm now.
+    pub(super) fn due(&self) -> bool {
+        !self.done && self.settled.is_some_and(|t| t.elapsed() >= SETTLE)
+    }
+
+    /// The first of `others` (a key and its folder) whose folder isn't `current` or one already
+    /// warmed, marked warmed; `None` (and no more asking) when all are.
+    pub fn pick<T: Copy>(&mut self, current: &str, others: &[(T, String)]) -> Option<T> {
+        if !self.folders.iter().any(|f| f == current) {
+            self.folders.push(current.to_owned());
+        }
+        let found = others.iter().find(|(_, f)| !self.folders.contains(f));
+        match found {
+            Some((key, folder)) => {
+                self.folders.push(folder.clone());
+                Some(*key)
+            }
+            None => {
+                self.done = true;
+                None
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn others() -> Vec<(i32, String)> {
+        vec![(-1, "world-1".into()), (1, "world1".into())]
+    }
+
+    #[test]
+    fn each_distinct_folder_is_picked_once() {
+        let mut warm = Warm::default();
+        assert_eq!(warm.pick("world0", &others()), Some(-1));
+        assert_eq!(warm.pick("world0", &others()), Some(1));
+        assert_eq!(warm.pick("world0", &others()), None);
+        assert!(warm.done);
+    }
+
+    #[test]
+    fn the_current_folder_and_shared_folders_are_not_warmed() {
+        let mut warm = Warm::default();
+        // The nether runs the overworld's folder; the end has its own.
+        let both = vec![(0, "world0".to_owned()), (1, "world1".to_owned())];
+        assert_eq!(warm.pick("world0", &both), Some(1));
+        assert_eq!(warm.pick("world0", &both), None);
+        // Another pack: nothing is remembered.
+        let mut fresh = Warm::default();
+        assert_eq!(fresh.pick("world1", &both), Some(0));
+    }
+
+    #[test]
+    fn not_due_until_settled() {
+        let mut warm = Warm::default();
+        assert!(!warm.due());
+        warm.settled = Some(Instant::now() - SETTLE);
+        assert!(warm.due());
+        warm.done = true;
+        assert!(!warm.due());
+    }
+}
