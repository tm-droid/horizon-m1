+/// What decides whether consecutive programs share one render pass (see `run_lengths`).
+struct RunShape<'a> {
+    merges: bool,
+    writes: &'a [(u32, usize)],
+    reads: u16,
+    written: u16,
+}
+
+/// Splits consecutive programs into runs one render pass can draw, in order. A program joins
+/// the run before it only if both `merge`, write exactly the same (location, buffer) outputs
+/// (so identical attachments), and none samples a buffer another in the run writes. Everything
+/// else, in particular any program that copies, clears or snapshots anything when bound, stays
+/// a pass of its own.
+fn run_lengths(shapes: &[RunShape<'_>]) -> Vec<usize> {
+    let mut lengths = Vec::new();
+    let mut at = 0;
+    while at < shapes.len() {
+        let head = &shapes[at];
+        let mut end = at + 1;
+        if head.merges {
+            let (mut reads, mut written) = (head.reads, head.written);
+            while let Some(next) = shapes.get(end) {
+                if !next.merges
+                    || next.writes != head.writes
+                    || next.reads & written != 0
+                    || next.written & reads != 0
+                {
+                    break;
+                }
+                reads |= next.reads;
+                written |= next.written;
+                end += 1;
+            }
+        }
+        lengths.push(end - at);
+        at = end;
+    }
+    lengths
 }
 
