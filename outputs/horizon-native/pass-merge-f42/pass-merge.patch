+#[cfg(test)]
+mod pass_merge_tests {
+    use super::{RunShape, run_lengths};
+
+    const A: &[(u32, usize)] = &[(0, 0), (1, 1)];
+    const B: &[(u32, usize)] = &[(0, 0), (1, 3)];
+
+    fn shape(merges: bool, writes: &'static [(u32, usize)], reads: u16, written: u16) -> RunShape<'static> {
+        RunShape { merges, writes, reads, written }
+    }
+
+    #[test]
+    fn same_outputs_merge_and_order_is_kept() {
+        let s = [shape(true, A, 0, 0b11), shape(true, A, 0b100, 0b11), shape(true, A, 0, 0b11)];
+        assert_eq!(run_lengths(&s), vec![3]);
+    }
+
+    #[test]
+    fn different_outputs_split() {
+        let s = [shape(true, A, 0, 0b11), shape(true, B, 0, 0b1011), shape(true, B, 0, 0b1011)];
+        assert_eq!(run_lengths(&s), vec![1, 2]);
+    }
+
+    #[test]
+    fn a_program_that_samples_what_the_run_wrote_starts_a_new_pass() {
+        let s = [shape(true, A, 0, 0b11), shape(true, A, 0b10, 0b11)];
+        assert_eq!(run_lengths(&s), vec![1, 1]);
+        // And the reverse: the new program writes what the run sampled.
+        let s = [shape(true, A, 0b1000, 0b11), shape(true, A, 0, 0b1000)];
+        assert_eq!(run_lengths(&s), vec![1, 1]);
+    }
+
+    #[test]
+    fn a_program_that_cannot_merge_is_alone_and_splits_the_run() {
+        let s = [
+            shape(true, A, 0, 0b11),
+            shape(true, A, 0, 0b11),
+            shape(false, A, 0, 0b11),
+            shape(true, A, 0, 0b11),
+            shape(true, A, 0, 0b11),
+        ];
+        assert_eq!(run_lengths(&s), vec![2, 1, 2]);
+        let s = [shape(false, A, 0, 0b11), shape(false, A, 0, 0b11)];
+        assert_eq!(run_lengths(&s), vec![1, 1]);
+    }
+
+    #[test]
+    fn every_program_is_in_exactly_one_run() {
+        let mut seed = 12345u32;
+        for _ in 0..500 {
+            let mut s = Vec::new();
+            for _ in 0..(seed % 9) {
+                seed = seed.wrapping_mul(1664525).wrapping_add(1013904223);
+                let writes = if seed >> 29 & 1 == 0 { A } else { B };
+                s.push(shape(seed >> 28 & 3 != 0, writes, (seed >> 8 & 0xf) as u16, (seed >> 12 & 0xf) as u16));
+            }
+            seed = seed.wrapping_mul(1664525).wrapping_add(1013904223);
+            let lengths = run_lengths(&s);
+            assert_eq!(lengths.iter().sum::<usize>(), s.len());
+            assert!(lengths.iter().all(|&l| l >= 1));
+        }
+    }
+}
