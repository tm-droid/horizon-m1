+    /// Whether any expression reads `name`, including variables and inactive branches.
+    /// Every item is evaluated each frame; conservatively keep dependencies even when a
+    /// later variable shadows the name or a branch would not currently execute.
+    pub fn references(&self, name: &str) -> bool {
+        fn reads(expr: &Expr, name: &str) -> bool {
+            match expr {
+                Expr::Num(_) => false,
+                Expr::Name(n, _) => n == name,
+                Expr::Call(_, args, _) => args.iter().any(|e| reads(e, name)),
+                Expr::Neg(e) | Expr::Not(e) => reads(e, name),
+                Expr::Bin(_, left, right) => reads(left, name) || reads(right, name),
+            }
+        }
+        self.items.iter().any(|item| reads(&item.expr, name))
     }
 
