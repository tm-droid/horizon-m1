+    /// Whether a loaded graphics/compute stage or custom expression needs a uniform.
+    /// Include lines explicitly: `every_program` predates that geometry path.
+    pub fn uses_uniform(&self, name: &str) -> bool {
+        self.custom.references(name)
+            || self.every_program().chain(self.lines.iter()).any(|p| {
+                p.program.as_ref().is_some_and(|program| {
+                    program.interface.uniforms.iter().any(|u| u.name == name)
+                }) || p.compute.iter().any(|(_, program)| {
+                    program.interface.uniforms.iter().any(|u| u.name == name)
+                })
+            })
     }
 
