+    #[test]
+    fn rot_x_and_rot_y_are_radians() {
+        let mut m = mob();
+        m.body_yaw = 90.0;
+        m.previous_body_yaw = 90.0;
+        m.head_pitch = 180.0;
+        let s = State {
+            pos: 0.0,
+            speed: 0.0,
+            age: 0.0,
+            y_rot: 0.0,
+            x_rot: 0.0,
+            swing: 0.0,
+            baby: false,
+            partial: 0.5,
+        };
+        let model = bone("root", vec![]);
+        let animation = animate(&model, &[("root.tx", "rot_y"), ("root.ty", "rot_x")]);
+        let mut poses = Poses::new(&model);
+        animation.run_in(&Frame::default(), &m, &s, &mut poses);
+        assert!((poses.get("root")[0] - std::f32::consts::FRAC_PI_2).abs() < 1.0e-5);
+        assert!((poses.get("root")[1] - std::f32::consts::PI).abs() < 1.0e-5);
+    }
