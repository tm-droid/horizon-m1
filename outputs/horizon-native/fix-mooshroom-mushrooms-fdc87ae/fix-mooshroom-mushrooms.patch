+/// Where a pack's custom model (CEM) has one of the mob's parts this frame against vanilla's
+/// part at rest, in model space. A layer placed in model space against the vanilla part (the
+/// mooshroom's body mushrooms) follows the pack's part through it. The boxes are compared,
+/// not the bones: a pack's bones rest elsewhere than vanilla's (Fresh Animations writes the
+/// cow's `body.rx` near 0 over vanilla's 90 degrees and turns the box back with a submodel).
+/// `None` without a custom model for the mob or without the part.
+pub fn cem_part_motion(m: &Mob, alpha: f32, data: &MobData, part: &str) -> Option<glam::Mat4> {
+    let (model_key, _) = body(m);
+    let custom = data
+        .cem
+        .read()
+        .unwrap_or_else(std::sync::PoisonError::into_inner)
+        .layer(cem_key(&model_key))
+        .is_some();
+    if !custom {
+        return None;
+    }
+    let (model, poses, _) = posed_body(m, alpha, data);
+    let vanilla = m
+        .kind
+        .layer(&model_key)
+        .cloned()
+        .unwrap_or_else(|| m.kind.model.clone());
+    part_motion(&model, &poses, &vanilla, part)
+}
+/// [`cem_part_motion`] for a posed model against the vanilla one at rest.
+fn part_motion(model: &Part, poses: &Poses, vanilla: &Part, part: &str) -> Option<glam::Mat4> {
+    let (_, now) = biggest_box(model, glam::Mat4::IDENTITY, poses, part, false)?;
+    let (_, rest) = biggest_box(vanilla, glam::Mat4::IDENTITY, &Poses::new(vanilla), part, false)?;
+    Some(now * rest.inverse())
+}
+/// The biggest bone of boxes in the part named `name` (or below it): its volume, and its
+/// matrix moved to the centre of its boxes.
+fn biggest_box(
+    p: &Part,
+    parent: glam::Mat4,
+    poses: &Poses,
+    name: &str,
+    inside: bool,
+) -> Option<(f32, glam::Mat4)> {
+    let q = poses.pose(p);
+    let m = parent
+        * glam::Mat4::from_translation(glam::Vec3::new(q[0], q[1], q[2]) / 16.0)
+        * glam::Mat4::from_quat(glam::Quat::from_euler(glam::EulerRot::ZYX, q[5], q[4], q[3]))
+        * glam::Mat4::from_scale(glam::Vec3::new(q[6], q[7], q[8]));
+    let inside = inside || p.name == name;
+    let mut best = None;
+    if inside && !p.polygons.is_empty() {
+        let (mut lo, mut hi) = (glam::Vec3::splat(f32::MAX), glam::Vec3::splat(f32::MIN));
+        for v in p.polygons.iter().flat_map(|poly| poly.vertices.iter()) {
+            let v = glam::Vec3::new(v[0], v[1], v[2]);
+            lo = lo.min(v);
+            hi = hi.max(v);
+        }
+        let size = hi - lo;
+        best = Some((
+            size.x * size.y * size.z,
+            m * glam::Mat4::from_translation((lo + hi) / 32.0),
+        ));
+    }
+    for c in &p.children {
+        if let Some(b) = biggest_box(c, m, poses, name, inside)
+            && best.is_none_or(|(v, _)| b.0 > v)
+        {
+            best = Some(b);
+        }
+    }
+    best
+}
