+        let vanilla = boxed("body", [0.0, 5.0, 2.0, turned, 0.0, 0.0, 1.0, 1.0, 1.0], lo, hi, vec![]);
+        let rotation = boxed("rotation", [0.0, 0.0, 0.0, turned, 0.0, 0.0, 1.0, 1.0, 1.0], lo, hi, vec![]);
+        let pack = Part {
+            name: "body".into(),
+            pose: [0.0, 5.0, 2.0, 0.0, 0.0, 0.0, 1.0, 1.0, 1.0],
