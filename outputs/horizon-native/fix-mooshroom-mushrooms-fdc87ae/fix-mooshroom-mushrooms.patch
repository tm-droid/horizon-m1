+    /// A part with one box from `lo` to `hi` (two opposite faces span it).
+    fn boxed(name: &str, pose: [f32; 9], lo: [f32; 3], hi: [f32; 3], children: Vec<Part>) -> Part {
+        let face = |z: f32| crate::mobs::Polygon {
+            normal: [0.0, 0.0, 1.0],
+            cull_back: false,
+            vertices: [
+                [lo[0], lo[1], z, 0.0, 0.0],
+                [hi[0], lo[1], z, 0.0, 0.0],
+                [hi[0], hi[1], z, 0.0, 0.0],
+                [lo[0], hi[1], z, 0.0, 0.0],
+            ],
+        };
+        Part {
+            name: name.into(),
+            pose,
+            polygons: vec![face(lo[2]), face(hi[2])],
+            children,
+        }
+    }
