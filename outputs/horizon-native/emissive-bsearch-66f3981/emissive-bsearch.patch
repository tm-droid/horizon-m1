+
+#[cfg(test)]
+mod emissive_lookup_tests {
+    use super::*;
+
+    /// terrain.wgsl's old per-vertex scan.
+    fn linear(table: &[[u32; 4]], n: usize, layer: u32) -> u32 {
+        for pair in &table[..n.min(128)] {
+            if pair[0] == layer {
+                return pair[1];
+            }
+            if pair[0] > layer {
+                break;
+            }
+        }
+        u32::MAX
+    }
+
+    /// terrain.wgsl's lower-bound search, step for step (8 bounded halvings).
+    fn bsearch(table: &[[u32; 4]], n: usize, layer: u32) -> u32 {
+        let n = n.min(128);
+        let (mut lo, mut hi) = (0, n);
+        let mut s = 0;
+        while s < 8 && lo < hi {
+            let mid = (lo + hi) / 2;
+            if table[mid][0] < layer {
+                lo = mid + 1;
+            } else {
+                hi = mid;
+            }
+            s += 1;
+        }
+        if lo < n && table[lo][0] == layer { table[lo][1] } else { u32::MAX }
+    }
+
+    fn rng(seed: &mut u64) -> u64 {
+        *seed ^= *seed << 13;
+        *seed ^= *seed >> 7;
+        *seed ^= *seed << 17;
+        *seed
+    }
+
+    #[test]
+    fn the_search_is_the_scan_for_every_table_size_and_layer() {
+        let mut seed = 0x9e3779b97f4a7c15;
+        for n in 0..=MAX {
+            for round in 0..20 {
+                // Strictly increasing keys, as `table` builds them, with gaps.
+                let mut key = (rng(&mut seed) % 5) as u32;
+                let mut table = vec![[0u32; 4]; MAX];
+                for pair in table.iter_mut().take(n) {
+                    *pair = [key, key + 1000 + round, 0, 0];
+                    key += 1 + (rng(&mut seed) % 4) as u32;
+                }
+                for layer in 0..key + 3 {
+                    assert_eq!(linear(&table, n, layer), bsearch(&table, n, layer), "n={n} layer={layer}");
+                }
+                assert_eq!(linear(&table, n, 0x7fff), bsearch(&table, n, 0x7fff));
+            }
+        }
+    }
+
+    #[test]
+    fn eight_halvings_cover_the_largest_table() {
+        assert!(MAX <= 128, "terrain.wgsl and entity.wgsl size the table at 128");
+        assert!((MAX + 1).next_power_of_two().trailing_zeros() <= 8);
+    }
+
+    #[test]
+    fn the_wgsl_uses_the_search_and_the_same_table_size() {
+        let wgsl = include_str!("terrain.wgsl");
+        assert!(wgsl.contains("array<vec4<u32>, 128>"));
+        assert!(wgsl.contains("emi_s < 8u"));
+        assert!(!wgsl.contains("i < min(globals.emissive_count.x, 128u)"));
+    }
+
+    #[test]
+    fn tables_are_strictly_increasing_by_base_layer() {
+        let layers: BTreeMap<String, u32> = (0..60u32).map(|i| (format!("s{i}"), 200 - i * 3)).collect();
+        let optifine: Vec<(String, String)> =
+            (0..20).map(|i| (format!("s{}", 59 - i), format!("s{}", i))).collect();
+        let native: Vec<(String, String)> =
+            (0..10).map(|i| (format!("s{}", 30 + i), "s0".to_owned())).collect();
+        let t = table(&layers, native.iter().map(|(a, b)| (a.as_str(), b.as_str())), &optifine);
+        assert!(!t.is_empty());
+        assert!(t.windows(2).all(|w| w[0][0] < w[1][0]), "sorted and unique: the shader searches it");
+    }
+
+    #[test]
+    fn the_cached_table_is_the_table() {
+        let layers: BTreeMap<String, u32> = (0..80u32).map(|i| (format!("s{i}"), (i * 7) % 83)).collect();
+        let optifine: Vec<(String, String)> = (0..40).map(|i| (format!("s{i}"), format!("s{}", 79 - i))).collect();
+        let cached = optifine_table(&layers, &optifine);
+        let none: [(&str, &str); 0] = [];
+        assert_eq!(table(&layers, none, &optifine), table_cached(&layers, none, &cached));
+        // A native pair for a base the pack also pairs wins in both.
+        let native = [("s3", "s70"), ("s50", "s2"), ("missing", "s2"), ("s4", "gone")];
+        assert_eq!(table(&layers, native, &optifine), table_cached(&layers, native, &cached));
+        // More than the 32 native requests: the same first 32.
+        let many: Vec<(String, String)> = (0..60).map(|i| (format!("s{i}"), "s79".to_owned())).collect();
+        let many = many.iter().map(|(a, b)| (a.as_str(), b.as_str())).collect::<Vec<_>>();
+        assert_eq!(
+            table(&layers, many.iter().copied(), &optifine),
+            table_cached(&layers, many.iter().copied(), &cached)
+        );
+        // No OptiFine pairs and no layers at all.
+        assert_eq!(table(&BTreeMap::new(), none, &[]), table_cached(&BTreeMap::new(), none, &[]));
+    }
+}
