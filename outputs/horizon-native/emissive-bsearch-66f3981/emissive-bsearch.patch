+/// The OptiFine half of [`table`], flagged [`CUTOUT`]: it only changes when resources reload, so
+/// `RenderAssets` builds it once.
+pub fn optifine_table(
+    layers: &BTreeMap<String, u32>,
+    optifine: &[(String, String)],
+) -> Vec<[u32; 4]> {
+    let optifine = optifine.iter().map(|(b, o)| (b.as_str(), o.as_str()));
+    mappings(layers, optifine)
+        .into_iter()
+        .map(|[b, o, z, w]| [b, o | CUTOUT, z, w])
+        .collect()
+}
+
+/// [`table`] with the OptiFine half prebuilt by [`optifine_table`]: the same pairs in the same
+/// order, without the per-frame name lookups. Without native requests (the usual frame) the
+/// prebuilt half is the table.
+pub fn table_cached<'a>(
+    layers: &BTreeMap<String, u32>,
+    native: impl IntoIterator<Item = (&'a str, &'a str)>,
+    optifine: &[[u32; 4]],
+) -> Vec<[u32; 4]> {
+    let mut native = native.into_iter().take(NATIVE).peekable();
+    if native.peek().is_none() {
+        return optifine.to_vec();
+    }
+    let mut by_base: BTreeMap<u32, [u32; 4]> = BTreeMap::new();
+    for pair in mappings(layers, native) {
+        by_base.insert(pair[0], pair);
+    }
+    for &pair in optifine {
+        by_base.entry(pair[0]).or_insert(pair);
+    }
+    by_base.into_values().collect()
+}
