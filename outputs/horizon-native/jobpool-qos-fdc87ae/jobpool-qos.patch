+/// Called by a general job-pool worker and by a LAN chunk-encode thread as it
+/// starts: the other bulk helpers (meshing, lighting, chunk encoding) that the
+/// render thread must never wait behind. Like `behind_server` it only acts after
+/// `put_helpers_behind`. On Linux and Android that is `behind_server`. On macOS
+/// `behind` does nothing, and a thread started from the render thread inherits its
+/// user-interactive quality of service, so the helpers competed with it for the
+/// four performance cores. They now drop to user-initiated at the lowest relative
+/// priority: below the render, server and remote-chunk threads, above the default
+/// and utility classes, and still free to use performance cores (utility would
+/// steer them to the efficiency cores and slow chunk loading). Windows is unchanged.
+/// Whether the OS took it.
+pub fn pool_helper_current() -> bool {
+    HELPERS_BEHIND.load(Ordering::Relaxed) && pool_helper()
+}
+
+#[cfg(target_vendor = "apple")]
+fn pool_helper() -> bool {
+    // SAFETY: sets the calling thread's own QoS class; no pointers.
+    unsafe {
+        libc::pthread_set_qos_class_self_np(libc::qos_class_t::QOS_CLASS_USER_INITIATED, -15) == 0
+    }
+}
+
+#[cfg(not(target_vendor = "apple"))]
+fn pool_helper() -> bool {
+    behind()
+}
